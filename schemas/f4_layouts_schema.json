{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F4_Traditional_Agency_Files_Contract",
  "catalog_version": "1.1.0",
  "description": "Contract for F4 weekly agency files (one per agency and ISO week, CSV or Excel) aligned with shared catalog v1.1.0. Every row carries the arguments of operation.reservar().",
  "expected_agency_count": 15,
  "agencies": [
    {
      "code": "AG01",
      "name": "ViajaFacil",
      "commission_pct": 10
    },
    {
      "code": "AG02",
      "name": "SolyMar Tours",
      "commission_pct": 10
    },
    {
      "code": "AG03",
      "name": "EuroTrip Agency",
      "commission_pct": 10
    },
    {
      "code": "AG04",
      "name": "Andes Travel",
      "commission_pct": 10
    },
    {
      "code": "AG05",
      "name": "GlobalStay Agency",
      "commission_pct": 10
    },
    {
      "code": "AG06",
      "name": "CaribeViajes",
      "commission_pct": 10
    },
    {
      "code": "AG07",
      "name": "MontanaTours",
      "commission_pct": 10
    },
    {
      "code": "AG08",
      "name": "CostaBella Travel",
      "commission_pct": 10
    },
    {
      "code": "AG09",
      "name": "NorteSur Agencia",
      "commission_pct": 10
    },
    {
      "code": "AG10",
      "name": "Horizonte Viajes",
      "commission_pct": 10
    },
    {
      "code": "AG11",
      "name": "Rutas del Sur",
      "commission_pct": 10
    },
    {
      "code": "AG12",
      "name": "BlueSky Agency",
      "commission_pct": 10
    },
    {
      "code": "AG13",
      "name": "Destino Feliz",
      "commission_pct": 10
    },
    {
      "code": "AG14",
      "name": "Puerta del Sol Travel",
      "commission_pct": 10
    },
    {
      "code": "AG15",
      "name": "Viajes Amanecer",
      "commission_pct": 10
    }
  ],
  "file_naming_pattern": "^AG(0[1-9]|1[0-5])_\\d{4}-W\\d{2}\\.(csv|xlsx)$",
  "commission_rate_expected": 0.1,
  "allowed_hotel_codes": [
    "HP-PT-001",
    "HP-PT-002",
    "HP-PT-003",
    "HP-CO-001",
    "HP-CO-002",
    "HP-CO-003",
    "HP-CO-004",
    "HP-CO-005",
    "HP-CO-006",
    "HP-CO-007",
    "HP-CO-008",
    "HP-CO-009",
    "HP-CO-010",
    "HP-MX-001",
    "HP-MX-002",
    "HP-MX-003",
    "HP-MX-004",
    "HP-MX-005",
    "HP-MX-006",
    "HP-BR-001",
    "HP-BR-002",
    "HP-BR-003",
    "HP-BR-004",
    "HP-BR-005",
    "HP-BR-006",
    "HP-ES-001",
    "HP-ES-002",
    "HP-ES-003"
  ],
  "allowed_room_types": [
    "SINGLE",
    "DOUBLE",
    "TWIN",
    "SUITE"
  ],
  "allowed_currencies": [
    "COP",
    "MXN",
    "BRL",
    "EUR",
    "USD"
  ],
  "reporting_currency": "COP",
  "layouts": {
    "A": {
      "format": "csv",
      "description": "Even agencies (AG02, AG04, AG06, AG08, AG10, AG12, AG14). rate_type REFUNDABLE/NON_REFUNDABLE, commission as fraction (0.1).",
      "columns": [
        "agency_booking_id",
        "guest_ref",
        "guest_name",
        "hotel_id",
        "check_in",
        "check_out",
        "room_type",
        "rooms",
        "adults",
        "children",
        "rate_type",
        "currency",
        "total_amount",
        "commission_rate"
      ]
    },
    "B": {
      "format": "csv",
      "description": "Odd agencies not on Excel (AG01, AG05, AG09, AG13). non_refundable Y/N, commission in percent (10).",
      "columns": [
        "booking_ref",
        "hotel_id",
        "guest_code",
        "guest_full_name",
        "checkin_date",
        "checkout_date",
        "room_category",
        "num_rooms",
        "pax_adults",
        "pax_children",
        "non_refundable",
        "amount",
        "currency",
        "commission_pct"
      ]
    },
    "C": {
      "format": "xlsx",
      "description": "Excel agencies (AG03, AG07, AG11, AG15). Spanish headers, date cells, tarifa reembolsable/no_reembolsable, commission as fraction.",
      "columns": [
        "localizador",
        "cod_huesped",
        "nombre_huesped",
        "hotel",
        "fecha_llegada",
        "fecha_salida",
        "tipo_habitacion",
        "habitaciones",
        "adultos",
        "ninos",
        "tarifa",
        "importe",
        "moneda",
        "comision"
      ]
    }
  },
  "canonical_mapping": {
    "A": {
      "agency_booking_id": "agency_booking_id",
      "guest_ref": "guest_ref",
      "guest_name": "guest_name",
      "hotel_id": "hotel_id",
      "check_in": "check_in",
      "check_out": "check_out",
      "room_type": "room_type",
      "rooms": "rooms",
      "adults": "adults",
      "children": "children",
      "refundable": "rate_type",
      "currency": "currency",
      "total_amount": "total_amount",
      "commission_rate": "commission_rate"
    },
    "B": {
      "agency_booking_id": "booking_ref",
      "guest_ref": "guest_code",
      "guest_name": "guest_full_name",
      "hotel_id": "hotel_id",
      "check_in": "checkin_date",
      "check_out": "checkout_date",
      "room_type": "room_category",
      "rooms": "num_rooms",
      "adults": "pax_adults",
      "children": "pax_children",
      "refundable": "non_refundable",
      "currency": "currency",
      "total_amount": "amount",
      "commission_rate": "commission_pct"
    },
    "C": {
      "agency_booking_id": "localizador",
      "guest_ref": "cod_huesped",
      "guest_name": "nombre_huesped",
      "hotel_id": "hotel",
      "check_in": "fecha_llegada",
      "check_out": "fecha_salida",
      "room_type": "tipo_habitacion",
      "rooms": "habitaciones",
