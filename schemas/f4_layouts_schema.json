  "folder_pattern": "output/f4_agency_files/<YYYY-Www>/",
  "canonical_fields": [
    "agency_booking_id",
    "guest_ref",
    "guest_name",
    "hotel_id",
    "check_in",
    "check_out",
    "room_type",
    "rooms",
    "adults",
    "children",
    "refundable",
    "currency",
    "total_amount",
    "commission_rate"
  ]
}
