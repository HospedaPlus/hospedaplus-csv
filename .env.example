# HospedaPlus Revenue — buenavista-csv Configuration
F1_CSV_PATH=data/f1_historical/hotel_bookings.csv
F2_REFERENCE_EVENTS_PATH=data/f2_reference/events.jsonl
F4_OUTPUT_DIR=output/f4_agency_files
VALIDATION_REPORT_DIR=output/validation_reports

# F4 Simulation & Defect Injection Parameters (US-25 / US-26)
# ISO week for a manual run, e.g. 2026-W45 (empty = current week)
F4_WEEK=

# docker compose: when the weekly run happens (0 = Monday)
F4_RUN_WEEKDAY=0
F4_RUN_HOUR_UTC=6
F4_SEED=7
F4_BOOKINGS_PER_AGENCY=12
F4_DUPLICATE_COUNT=3
F4_MISSING_CURRENCY_RATE=0.10

# Neon (same database as F2/F3, schema operation)
# Read-only role etl_reader: generator copies real F2 bookings as cross-channel duplicates
NEON_READ_URL=
# Role app_writer: loader books each agency row through operation.reservar()
NEON_DATABASE_URL=


# AWS S3 Bronze Landing Zone (Batch Ingestion Target)
AWS_REGION=us-east-2
S3_BRONZE_BUCKET=s3://hospedaplus-datalake-bronze
S3_F1_PREFIX=f1_historical/
S3_F4_PREFIX=f4_agencies/


#docker compose up -d --build
#docker compose logs -f f4-weekly